GITLAB_TOKEN=glpat-...
CURSOR_API_KEY=...
MCP_TOKEN=...
DEMO_GITLAB_GROUP=your-gitlab-username-or-group
JIRA_TOKEN=...
JIRA_EMAIL=you@example.com
# Full Authorization header for the Jira dashboard plugin (Basic base64 of email:token):
# JIRA_AUTH_HEADER=Basic $(printf '%s' 'you@example.com:glpat-...' | base64)
JIRA_AUTH_HEADER=Basic ...

# Optional overrides
# NOPCOMMERCE_SOURCE=/path/to/nopCommerce
